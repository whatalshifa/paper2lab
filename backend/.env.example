# Copy to .env for local development. Every setting is optional: the defaults below run the API
# on SQLite with PDFs in a local folder. Settings use the P2L_ prefix (see app/config.py).

# Leave empty to run in demo mode: the two sample papers work, adding new papers and asking new
# questions is paused.
ANTHROPIC_API_KEY=

# "production" turns on secure cookies and hides the API docs.
P2L_ENV=development

# SQLite locally; a Postgres URL (Neon) in production. postgres:// URLs are accepted as given.
P2L_DATABASE_URL=sqlite:///./paper2lab.db

# Where uploaded PDFs go: "local" (P2L_UPLOAD_DIR) or "s3" (any S3-compatible bucket).
P2L_STORAGE=local
P2L_UPLOAD_DIR=./uploads
# P2L_S3_BUCKET=papers
# P2L_S3_ENDPOINT_URL=
# P2L_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# The website's address, for tools that call the API from another origin.
P2L_CORS_ORIGINS=["http://localhost:3000"]

# A shared secret the website adds to every /api request (its API_PROXY_SECRET). Empty turns the
# check off, which is fine on your own computer.
P2L_PROXY_SECRET=

# Size limits checked before any AI call.
# P2L_MAX_UPLOAD_MB=20
# P2L_MAX_PAGES=60

# Which Claude model reads papers, and how hard it thinks.
# P2L_CLAUDE_MODEL=claude-opus-5-5
# P2L_CLAUDE_EFFORT=medium
# P2L_ANSWER_EFFORT=medium

# Spending guards.
# P2L_PAPERS_PER_LIBRARY_PER_DAY=5
# P2L_PAPERS_PER_IP_PER_HOUR=10
# P2L_PAPERS_PER_DAY_TOTAL=40
# P2L_QUESTIONS_PER_LIBRARY_PER_DAY=30
# P2L_QUESTIONS_PER_IP_PER_HOUR=40
# P2L_QUESTIONS_PER_DAY_TOTAL=300

# References, code, models and datasets for each paper (Semantic Scholar and Hugging Face).
# P2L_CONNECTIONS_ENABLED=true
# P2L_SEMANTIC_SCHOLAR_API_KEY=

# Re-run papers a restart interrupted. Turn off when several copies of the API run at once.
# P2L_RECOVER_JOBS_ON_START=true
