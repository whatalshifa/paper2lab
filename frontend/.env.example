# Copy to .env.local for local development.

# Where the FastAPI backend runs. The website forwards /api/* there, and the home page reads the
# sample papers from it when it is built. Set before `npm run build`.
API_URL=http://localhost:8000

# Must match the API's P2L_PROXY_SECRET. Leave both empty on your own computer.
API_PROXY_SECRET=

# The site's public address, for share links, the sitemap and canonical URLs. On Vercel the
# production address is used when this is empty.
SITE_URL=
